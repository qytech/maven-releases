  <version>0.1.1</version>
  <packaging>aar</packaging>
  <name>QYTech Screen Mirror</name>
  <description>Closed-source screen capture, streaming, and remote input runtime for QYTech Android products.</description>
  <url>https://github.com/qytech/service-screenmirror</url>
  <inceptionYear>2026</inceptionYear>
  <licenses>
    <license>
