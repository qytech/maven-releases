      <id>qytech</id>
      <name>qytech</name>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/qytech/service-screenmirror.git</connection>
    <developerConnection>scm:git:ssh://github.com/qytech/service-screenmirror.git</developerConnection>
    <url>https://github.com/qytech/service-screenmirror</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.4.20</version>
      <scope>compile</scope>
    </dependency>
